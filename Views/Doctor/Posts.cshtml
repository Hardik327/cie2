@model List<_211_cie2.Controllers.Post>

@{
    ViewData["Title"] = "Posts";
}

<h1>Posts from JSONPlaceholder</h1>

<table border="1" cellpadding="10">

    <thead>
        <tr>
            <th>Post ID</th>
            <th>Title</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var post in Model)
        {
            <tr>
                <td>@post.id</td>

                <td>@post.title</td>
            </tr>
        }

    </tbody>

</table>

<br />

<a asp-action="Index">
    Back to Doctor List
</a>